
#include <iostream>
using namespace std;

int main() {
    int choice, quantity;
    float total = 0;

    cout << "----- Food Menu -----" << endl;
    cout << "1. Pizza  - Rs. 150" << endl;
    cout << "2. Burger - Rs. 80" << endl;
    cout << "3. Sandwich - Rs. 60" << endl;

    cout << "Enter your choice: ";
    cin >> choice;

    cout << "Enter quantity: ";
    cin >> quantity;

    if (choice == 1)
        total = 150 * quantity;
    else if (choice == 2)
        total = 80 * quantity;
    else if (choice == 3)
        total = 60 * quantity;
    else {
        cout << "Invalid choice!" << endl;
        return 0;
    }

    cout << "Total cost = Rs. " << total << endl;

    return 0;
}
