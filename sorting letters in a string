
#include <iostream>
#include <string>
using namespace std;

int main()
{
    string str;
    int i, j;
    char temp;

    cout << "Enter a string: ";
    getline(cin, str);

    for (i = 0; i < str.length() - 1; i++)
    {
        for (j = 0; j < str.length() - i - 1; j++)
        {
            if (str[j] > str[j + 1])
            {
                temp = str[j];
                str[j] = str[j + 1];
                str[j + 1] = temp;
            }
        }
    }

    cout << "Sorted string: " << str;

    return 0;
}
