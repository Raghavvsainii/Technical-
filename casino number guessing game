
#include <iostream>
#include <cstdlib>
#include <ctime>
using namespace std;

int main()
{
    int num, guess, attempts = 0;
    int choice, prize;

    srand(time(0));

    cout << "===== NUMBER GUESSING GAME =====" << endl;
    cout << "1. Easy (1 to 10) - Prize Rs. 100" << endl;
    cout << "2. Medium (1 to 50) - Prize Rs. 500" << endl;
    cout << "3. Hard (1 to 100) - Prize Rs. 1000" << endl;

    cout << "Choose difficulty: ";
    cin >> choice;

    int max;

    if (choice == 1)
    {
        max = 10;
        prize = 100;
    }
    else if (choice == 2)
    {
        max = 50;
        prize = 500;
    }
    else if (choice == 3)
    {
        max = 100;
        prize = 1000;
    }
    else
    {
        cout << "Invalid choice!";
        return 0;
    }

    num = rand() % max + 1;

    cout << "\nGuess the number between 1 and "
         << max << endl;

    do
    {
        cout << "Enter your guess: ";
        cin >> guess;
        attempts++;

        if (guess > num)
            cout << "Too high! Try again." << endl;
        else if (guess < num)
            cout << "Too low! Try again." << endl;
        else
        {
            cout << "\nCongratulations! You won!" << endl;
            cout << "Prize: Rs. " << prize << endl;
            cout << "Attempts: " << attempts << endl;
        }

    } while (guess != num);

    return 0;
}
