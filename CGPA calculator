
#include <iostream>
using namespace std;

int main()
{
    int n, i;
    float credits[10], grade[10];
    float totalCredits = 0;
    float totalPoints = 0;
    float gpa, cgpa;

    cout << "===== CGPA CALCULATOR =====" << endl;

    cout << "Enter number of subjects (max 10): ";
    cin >> n;

    if (n < 1 || n > 10)
    {
        cout << "Invalid number of subjects!";
        return 0;
    }

    for (i = 0; i < n; i++)
    {
        cout << "\nEnter credits for subject " << i + 1 << ": ";
        cin >> credits[i];

        cout << "Enter grade point (0 to 10): ";
        cin >> grade[i];

        totalCredits = totalCredits + credits[i];
        totalPoints = totalPoints + (credits[i] * grade[i]);
    }

    cout << "\n===== SUBJECT DETAILS =====" << endl;

    for (i = 0; i < n; i++)
    {
        cout << "Subject " << i + 1
             << " - Credits: " << credits[i]
             << ", Grade Point: " << grade[i] << endl;
    }

    if (totalCredits > 0)
    {
        gpa = totalPoints / totalCredits;
        cgpa = gpa;

        cout << "\nTotal Credits = " << totalCredits;
        cout << "\nTotal Grade Points = " << totalPoints;
        cout << "\nSemester GPA = " << gpa;
        cout << "\nCGPA = " << cgpa << endl;
    }
    else
    {
        cout << "Total credits must be greater than zero.";
    }

    return 0;
}
